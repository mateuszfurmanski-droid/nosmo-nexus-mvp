# Never commit real values.

# Private app login.
JOB_CONTROL_ACCESS_CODE_HASH=
JOB_CONTROL_SESSION_SECRET=

# Optional override; otherwise the adapter can reuse the secretReference
# declared by NEXUS_CLOUD_GOOGLE_DRIVE_CONFIG_JSON.
JOB_CONTROL_GOOGLE_SECRET_REFERENCE=NEXUS_SECRET_JOB_CONTROL_GOOGLE

# Server-only OAuth JSON:
# {"type":"google-oauth-refresh-token/v1","clientId":"...","clientSecret":"...","refreshToken":"..."}
NEXUS_SECRET_JOB_CONTROL_GOOGLE=

# Current Joanna Sheet (server-side only; default is already wired in code).
JOB_CONTROL_SHEET_ID=1WWTX9qmk3hVaWMii4AyS_VuyfEMxdbiJcuKXKKfCDi4

# Fail closed until read-only tests pass.
JOB_CONTROL_SHEETS_WRITE_ENABLED=false
JOB_CONTROL_GMAIL_SEND_ENABLED=false

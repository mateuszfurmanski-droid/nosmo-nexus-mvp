{
  "expo": {
    "name": "NEXUS Work Mode",
    "slug": "nosmo-nexus-work-mode",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "nosmonexus",
    "icon": "./assets/icon.png",
    "android": {
      "package": "tech.nosmo.nexus.workmode",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030407"
      },
      "permissions": [
        "READ_CONTACTS",
        "READ_CALENDAR"
      ]
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Nexus to discover work contacts you explicitly approve."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Nexus to find project-related calendar events you explicitly approve."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nexus to review work photos you choose to share with Work Mode."
        }
      ],
      "expo-document-picker"
    ],
    "extra": {
      "productLayer": "Construction Operating Layer",
      "privacyMode": "local-first-explicit-permission",
      "brandAsset": "NOSMO-website/assets/NEXUS_Logo.png",
      "workModeRevision": "v2-functional-discovery"
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="NEXUS Work Mode"
        android:theme="@style/AppTheme">
        <activity
            android:name=".WorkModeHomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".IdentityClaimActivity"
            android:exported="false" />

        <activity
            android:name=".WorkInboxActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".CloudEvidenceActivity"
            android:exported="false" />

        <activity
            android:name=".CloudEvidenceShortcutActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true" />

        <activity
            android:name=".HandoffResultActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="nosmo-nexus-workmode"
                    android:host="handoff-result" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MobileAuthResultActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="nosmo-nexus-workmode"
                    android:host="auth-result" />
            </intent-filter>
        </activity>
    </application>
</manifest>

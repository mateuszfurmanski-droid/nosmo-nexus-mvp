{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "scripts/src/nexus-cloud-google-drive-adapter.mjs",
        "scripts/src/work-wallet-api.mjs",
        "artifacts/api-server/package.json",
        "artifacts/nosmo-nexus/package.json"
      ]
    }
  }
}

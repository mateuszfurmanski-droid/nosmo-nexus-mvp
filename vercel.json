{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run typecheck:libs && pnpm --filter @workspace/api-server typecheck && pnpm --filter @workspace/nosmo-nexus typecheck && pnpm --filter @workspace/nosmo-nexus build && node artifacts/api-server/build-vercel-core-staging.mjs",
  "outputDirectory": "artifacts/nosmo-nexus/dist/public",
  "env": {
    "NEXUS_IDENTITY_BINDING_MODE": "postgres"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/project-worlds/esafe",
      "destination": "/index.html"
    },
    {
      "source": "/relationship-tree",
      "destination": "/index.html"
    },
    {
      "source": "/workspace",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/dist/**"
    }
  }
}

{
  "manifest_version": 3,
  "name": "NOSMO Nexus Overlay Prototype",
  "version": "0.1.0",
  "description": "Development prototype of the NOSMO Nexus sidecar runtime for approved external web applications.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://portal.work-wallet.com/*",
    "https://nosmotechnology.co.uk/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://portal.work-wallet.com/*"],
      "js": [
        "src/runtime.js",
        "src/record-mapping.js",
        "src/supply-request.js",
        "src/sidecar.js",
        "src/tree-handoff.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "NOSMO Nexus Overlay Prototype"
  }
}

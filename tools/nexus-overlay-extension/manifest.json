{
  "manifest_version": 3,
  "name": "NOSMO Nexus Overlay Prototype",
  "version": "0.1.0",
  "description": "Development prototype of the NOSMO Nexus sidecar runtime for approved external web applications.",
  "permissions": ["storage"],
  "host_permissions": ["https://portal.work-wallet.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://portal.work-wallet.com/*"],
      "js": ["src/runtime.js", "src/sidecar.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "NOSMO Nexus Overlay Prototype"
  }
}

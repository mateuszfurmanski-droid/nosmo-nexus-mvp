{
  "manifest_version": 3,
  "name": "NOSMO Nexus Work Wallet Overlay Prototype",
  "version": "0.2.0",
  "description": "Development prototype of the NOSMO Nexus read-only Work Wallet context sidecar.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://portal.work-wallet.com/*",
    "http://127.0.0.1:3000/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:3000/api/nexus/context-tickets/work-wallet/bootstrap*"
    ]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://portal.work-wallet.com/*"],
      "js": [
        "src/runtime.js",
        "src/sidecar.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "NOSMO Nexus Work Wallet Overlay Prototype"
  }
}
